# Puerto del servidor
PORT=3000

# Persistencia de Candidates: memory (por defecto) o sql (PostgreSQL con pg)
CANDIDATES_ADAPTER=sql

# Base de datos de desarrollo
DATABASE_URL=postgresql://postgres:tu_contrasena@localhost:5432/candidates_dev

# Base de datos de pruebas (debe ser distinta a la de desarrollo)
TEST_DATABASE_URL=postgresql://postgres:tu_contrasena@localhost:5432/candidates_test
